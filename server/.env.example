# ============================================================================
# CLUTCH SERVER — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Port
PORT=4000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Production CORS Allowlists (comma-separated origins)
ALLOWED_ORIGINS=https://clutch.arena,https://api.clutch.arena,http://localhost:5173

# Authoritative PostgreSQL Database URL
DATABASE_URL=postgres://clutch_admin:clutch_secure_db_password_2026@localhost:5432/clutch_db

# Strict Container Sandbox Enforcement
# When 'true', code execution is rejected unless running within verified container isolation
ENFORCE_CONTAINER_SANDBOX=false

# Dedicated Docker Runner Image Tag
RUNNER_DOCKER_IMAGE=clutch-sandbox-runner:latest

# External Judge Microservice URL (optional, e.g. Judge0 integration)
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here

# Gemini AI Challenge Generation Key (optional, falls back to built-in curated bank)
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# GOOGLE SHEETS LIVE PLATFORM SYNCHRONIZATION
# ============================================================================
# Enable or disable Google Sheets data synchronization
GOOGLE_SHEETS_ENABLED=true

# The existing Google Spreadsheet ID (from your Google Sheets URL)
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_EXISTING_SPREADSHEET_ID

# Path to the mounted Service Account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/clutch-google-service-account.json

# Optional alternative: Raw or Base64 encoded Service Account JSON string
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}

# Diagnostic Admin Secret Key for /api/admin/sheets endpoints
ADMIN_API_KEY=your_admin_secret_key_here
