# ============================================================================
# CLUTCH RUNNER MICROSERVICE — PRODUCTION DOCKERFILE
# Dedicated execution container decoupled from public API
# ============================================================================

# Stage 1: Build
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY shared ./shared
COPY server/package*.json ./server/
WORKDIR /app/server
RUN npm ci

COPY server/tsconfig.json ./
COPY server/src ./src
RUN npm run build

# Stage 2: Production Runtime
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV RUNNER_PORT=5050

# Install compilers and execution runtimes (Python3, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl python3 \
    && rm -rf /var/lib/apt/lists/*

COPY shared ./shared
COPY server/package*.json ./server/
WORKDIR /app/server
RUN npm ci --only=production

COPY --from=builder /app/server/dist ./dist

# Run as unprivileged node user
USER node

EXPOSE 5050

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5050/health || exit 1

CMD ["node", "dist/execution/runnerServer.js"]
