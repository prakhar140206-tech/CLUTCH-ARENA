# DSA BATTLE ARENA - Environment Configuration Example

# Server Port
PORT=4000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: External Sandboxed Code Execution Service (e.g. Judge0)
# If left empty, DSA Battle Arena automatically uses the isolated process sandbox fallback
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Optional: Database URL (e.g. PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dsa_battle_arena

# JWT Session Secret
JWT_SECRET=super_cyber_secret_key_change_in_production
