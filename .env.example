# ============================================================================
# CLUTCH / DSA BATTLE ARENA — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env and replace secrets with high-entropy values before production deployment
# ============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000

# Client Origins for CORS (comma-separated, no wildcards in production)
ALLOWED_ORIGINS=https://clutch.arena,http://localhost:5173

# Authoritative PostgreSQL Database
DATABASE_URL=postgres://clutch_admin:clutch_secure_db_password_2026@postgres:5432/clutch_db
DATABASE_PASSWORD=clutch_secure_db_password_2026

# Architecture A: Dedicated Runner Microservice Execution Boundary
# In production, point to the internal runner container on the private Docker network
RUNNER_SERVICE_URL=http://clutch-runner-service:5050
RUNNER_SERVICE_SECRET=clutch_runner_production_secret_key_2026_change_in_production
RUNNER_HTTP_TIMEOUT_MS=8000

# Security Boundaries
ENFORCE_CONTAINER_SANDBOX=true

# JWT Session Authentication Secret (use openssl rand -base64 48)
JWT_SECRET=super_cyber_secret_key_change_in_production_min_64_chars_recommended_for_security

# Optional: External Sandboxed Code Execution Service (e.g. Judge0)
JUDGE0_API_URL=
JUDGE0_API_KEY=
