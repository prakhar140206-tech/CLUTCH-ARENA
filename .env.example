# ============================================================================
# CLUTCH / DSA BATTLE ARENA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and substitute all placeholders with freshly generated credentials
# All production secrets MUST be at least 32 characters with high cryptographic entropy
# ============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000

# Production Client Origins for CORS (comma-separated exact URLs; no wildcards or localhost)
ALLOWED_ORIGINS=https://clutch.arena

# Authoritative PostgreSQL Database Credentials
# Generate via: openssl rand -base64 24
DATABASE_PASSWORD=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_BASE64_24
DATABASE_URL=postgres://clutch_admin:PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_BASE64_24@postgres:5432/clutch_db

# Architecture A: Dedicated Runner Microservice Boundary
RUNNER_SERVICE_URL=http://clutch-runner-service:5050
# Generate via: openssl rand -base64 32
RUNNER_SERVICE_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_BASE64_32
RUNNER_HTTP_TIMEOUT_MS=8000

# Strict Container Sandbox Enforcement
ENFORCE_CONTAINER_SANDBOX=true

# JWT Session Authentication Secret
# Generate via: openssl rand -base64 48
JWT_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# Optional: External Judge0 execution provider
JUDGE0_API_URL=
JUDGE0_API_KEY=
